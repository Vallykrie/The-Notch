<?xml version="1.0" encoding="UTF-8"?>
<!--
  Merged into the generated Info.plist (GENERATE_INFOPLIST_FILE stays on). Only the Sparkle
  update keys live here; everything else is still set through INFOPLIST_KEY_* build settings.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The appcast is published by .github/workflows/release.yml to the gh-pages branch. -->
	<key>SUFeedURL</key>
	<string>https://vallykrie.github.io/The-Notch/appcast.xml</string>
	<!--
	  EdDSA public key that verifies every update. The private half lives in the maintainer's
	  login keychain and in the SPARKLE_PRIVATE_KEY repository secret (see docs/RELEASING.md).
	  If this is ever emptied, the app does not start the updater at all.
	-->
	<key>SUPublicEDKey</key>
	<string>WCsOldyIbqExDerOJDGn+AKQO0qPDqkVzWdbkK08Bqg=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Six hours. Releases are weekly-ish; an hourly poll would be wasted traffic. -->
	<key>SUScheduledCheckInterval</key>
	<integer>21600</integer>
	<!--
	  Install updates silently: Sparkle downloads in the background with no prompt, and
	  AppUpdater's delegate installs and relaunches as soon as the download is ready instead of
	  waiting for a quit. Releases ship weekly; nobody should be left on an old build.
	-->
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
</dict>
</plist>
